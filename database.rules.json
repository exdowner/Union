{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "servers": {
      ".read": "auth != null",
      "$serverId": {
        ".write": "auth != null && (!data.exists() || data.child('ownerId').val() === auth.uid || root.child('serverMembers').child($serverId).child(auth.uid).exists())"
      }
    },

    "serverMembers": {
      "$serverId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "userServers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "channels": {
      "$serverId": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()"
      }
    },

    "messages": {
      "$serverId": {
        "$channelId": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()"
        }
      }
    },

    "posts": {
      "$serverId": {
        "$channelId": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()"
        }
      }
    },

    "replies": {
      "$serverId": {
        "$channelId": {
          "$postId": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()"
          }
        }
      }
    },

    "stickers": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "voicePresence": {
      "$serverId": {
        "$channelId": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    "calls": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
